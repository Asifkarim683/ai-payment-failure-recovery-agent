# Port configuration
PORT=3000

# Node environment
NODE_ENV=development

# Session & JWT secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Database URL (MySQL) - Optional, fallback in-memory store is used if omitted
DATABASE_URL=mysql://user:password@localhost:3306/recoverly

# App configuration
VITE_APP_ID=recoverly-app
